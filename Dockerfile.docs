# dbt docs static site (nginx). deploy_docs.sh temporarily renames this to
# `Dockerfile` for the build, and copies target/ -> public_docs first.

FROM nginx:alpine

COPY public_docs /usr/share/nginx/html

# Cloud Run sends traffic to 8080
RUN sed -i 's/listen  *80;/listen 8080;/' /etc/nginx/conf.d/default.conf

EXPOSE 8080
